{
  "name": "app-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "author": "Maxim Abuzarov",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "NODE_ENV=test node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/index.ts migrate",
    "seed": "tsx src/index.ts seed",
    "seal": "tsx src/index.ts seal",
    "test:coverage": "NODE_ENV=test node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-lines=85 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@dicebear/bottts-neutral": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@faker-js/faker": "^10.6.0",
    "compression": "^1.8.2",
    "express": "~5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "~5.0.1",
    "@types/node": "~24.13.3",
    "pino-pretty": "^13.2.0",
    "tsx": "~4.19.3",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
