{
  "name": "people-directory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": "",
  "author": "Maxim Abuzarov",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client:after-api\"",
    "dev:server": "npm -w app-server run dev",
    "dev:client": "npm -w app-client run dev",
    "dev:client:after-api": "wait-on -t 60000 http-get://localhost:7777/api/health && npm run dev:client",
    "build": "npm -w app-client run build && npm -w app-server run build",
    "start": "npm -w app-server run start",
    "seed": "npm -w app-server run seed",
    "seal": "npm -w app-server run seal",
    "migrate": "npm -w app-server run migrate",
    "test": "npm -w app-server run test && npm -w app-client run test",
    "test:coverage": "npm -w app-server run test:coverage && npm -w app-client run test:coverage",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "npm -w app-server run typecheck && npm -w app-client run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "concurrently": "~9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "~3.5.3",
    "typescript-eslint": "^8.72.2",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
